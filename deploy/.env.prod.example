# Copy to deploy/.env.prod (gitignored; deploy/bootstrap.sh does this and generates the secrets).
# Placeholders only. Never commit the real file. In Coolify/Dokploy, enter these in the UI instead.

# --- Which optional services run. caddy = reverse proxy with HTTPS; dva = the vulnerable demo
# agents. Drop `caddy` under Coolify/Dokploy (their proxy routes to the `web` service, port 3000).
COMPOSE_PROFILES=caddy,dva

# --- Public address. Set DOMAIN (DNS A/AAAA record pointing at this host, ports 80 and 443 open)
# for automatic HTTPS. Leave it empty for a plain-HTTP demo on http://<server-ip>/ (then also
# set GAUNTLET_INSECURE_COOKIE=1 so the browser accepts the login cookie over HTTP).
DOMAIN=
GAUNTLET_INSECURE_COOKIE=0
# Host ports Caddy binds. Change only when 80/443 are taken (e.g. local testing).
HTTP_PORT=80
HTTPS_PORT=443

# --- Secrets. bootstrap.sh generates all of these; to do it by hand see deploy/README.md.
POSTGRES_PASSWORD=change-me
# S3 key pair for SeaweedFS (names kept from the MinIO era so existing env files still work)
MINIO_ROOT_USER=gauntlet-s3
MINIO_ROOT_PASSWORD=change-me-too
# Fernet key encrypting stored secrets (target credentials). Losing it loses those secrets.
GAUNTLET_SECRET_KEY=
# Admin API key (gk_ + 20 or more chars). Paste it on the console login page. Created idempotently
# at every start. Rotate by changing it and restarting; the old key stops working only if you
# revoke it in the console.
GAUNTLET_ADMIN_API_KEY=

# --- Spend controls. Model calls only happen when OPENROUTER_API_KEY is set.
# Per-run cap (USD micros: 5000000 = $5); a request above it is clamped to it.
GAUNTLET_MAX_RUN_BUDGET_USD_MICROS=5000000
# Rolling 24 hour cap across all runs and campaigns, in USD; 0 disables. Over it: HTTP 429.
GAUNTLET_DAILY_BUDGET_USD=10
# Set true to reject every attack run at the API (ops lever). The kill switch in the console
# stops runs already in flight.
GAUNTLET_ATTACKS_DISABLED=false
# Provider key for live model runs. Also set a spend limit on the key itself at openrouter.ai.
OPENROUTER_API_KEY=

# --- Tuning
WORKER_CONCURRENCY=4
LOG_LEVEL=info
# DVA behaviour: llm (needs OPENROUTER_API_KEY) or a scripted brain; which flaws are armed.
DVA_BRAIN=llm
DVA_FLAWS=all
