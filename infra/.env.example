# Copy to infra/.env (gitignored). Every value here is a local-dev placeholder, never a real secret.

# --- Postgres (the dev database; tests use gauntlet_test on the same server)
POSTGRES_USER=gauntlet
POSTGRES_PASSWORD=gauntlet-dev-only
POSTGRES_DB=gauntlet
# Host port for Postgres; change it if 5432 is taken by a local server (then update TEST_DATABASE_URL).
POSTGRES_HOST_PORT=5432
# Used by containers (service names resolve on the compose network).
DATABASE_URL=postgresql+asyncpg://gauntlet:gauntlet-dev-only@postgres:5432/gauntlet
# Used by `uv run pytest` on the host. Integration tests skip when this is unset.
TEST_DATABASE_URL=postgresql+asyncpg://gauntlet:gauntlet-dev-only@localhost:5432/gauntlet_test

# --- Redis (cache and pub/sub only, nothing durable)
REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=6379

# --- S3 compatible storage (MinIO in dev)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minio-dev
S3_SECRET_KEY=minio-dev-secret
S3_BUCKET=gauntlet
S3_REGION=us-east-1
MINIO_ROOT_USER=minio-dev
MINIO_ROOT_PASSWORD=minio-dev-secret

# --- Platform
# `dev` enables the fixed dev API key and unauthenticated /openapi.json; anything else disables both.
GAUNTLET_ENV=dev
GAUNTLET_DEV_API_KEY=gk_dev_local_only
# Fernet key for stored secrets. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GAUNTLET_SECRET_KEY=
GAUNTLET_CONFIG=/app/gauntlet.toml
GAUNTLET_ALLOW_PRIVATE_TARGETS=false
GAUNTLET_LOCAL_TARGET_HOSTS=dva,localhost,127.0.0.1
WORKER_CONCURRENCY=4
LEASE_SECONDS=60
LOG_LEVEL=info

# --- Model providers. Leave empty here; export OPENROUTER_API_KEY in your shell and compose
# passes it through. Do not paste a real key into this file.
OPENROUTER_API_KEY=
